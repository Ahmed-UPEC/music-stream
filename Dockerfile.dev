FROM node:22-alpine

RUN apk add --no-cache git python3 make g++ docker-cli

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

ENV JELLYFIN_TARGET=http://localhost:8096 \
    METUBE_TARGET=http://localhost:3701 \
    PREVIEW_DIR=/data/preview-tmp \
    METUBE_CONTAINER=metube_metube_1

EXPOSE 5173

CMD ["node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173"]
